# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017/
MONGO_DB_NAME=qrcode_generator

# App Configuration
APP_SECRET_KEY=mySuperSecretKey123!
APP_ENV=development

# CORS Settings (comma-separated list of allowed origins)
CORS_ORIGINS=*

# Base URL for dynamic QR code redirects (e.g., https://yourdomain.com/qr/)
BASE_REDIRECT_URL=http://localhost:8000/qr/

# Optional: Sentry DSN for error tracking
# SENTRY_DSN=
